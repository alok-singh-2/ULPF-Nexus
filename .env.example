ULPF_AI_MODE=heuristic
ULPF_AI_BASE_URL=http://127.0.0.1:11434/v1
ULPF_AI_MODEL=gpt-oss-120b
ULPF_AI_TIMEOUT=20

ULPF_QUEUE_MAX_DEPTH=500
ULPF_QUEUE_WORKERS=2
ULPF_QUEUE_MAX_RETRIES=3
ULPF_QUEUE_POLL_SECONDS=0.20

ULPF_AUTH_MODE=production
ULPF_BOOTSTRAP_ADMIN=admin
ULPF_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ULPF_SESSION_TTL_SECONDS=3600
ULPF_ALLOWED_ORIGINS=http://localhost:8000
ULPF_LOG_LEVEL=INFO
